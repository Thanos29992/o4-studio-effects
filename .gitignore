# Keep templates
!state/*.sample

# Cache blobs (13GB+)
cache/
*.blob

# Compiled binaries
studio-effects
*.o
*.so

# Test artifacts
*.wav
test_raw.wav
test_processed.wav

# OpenVINO model cache
/tmp/studio-effects-ov-cache

# Python build artifacts
__pycache__/
*.pyc

# Benchmark dataset — 545MB, download PPM-100 separately
models/benchmark/PPM-100/
models/benchmark/PPM-100.zip
models/benchmark/ov_cache/

# RVM build intermediates (models/rvm/build_ir.py regenerates the IR)
