[Unit]
Description=Linux Studio Effects daemon (shlok.studio)
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/studio-effects --daemon
Restart=on-failure
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WAYLAND_DISPLAY=wayland-1

[Install]
WantedBy=default.target
